  156  lsblk
  157  sudo fdisk /dev/sdb
  158  sudo partprobe /dev/sdb
  159  lsblk
  160  sudo mkfs.ext4 -L MEPHI_WEB /dev/sdb1
  161  sudo blkid /dev/sdb1
